# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up back inside,
# since the whole folder is uploaded to the Workshop as-is.
build/
Source/obj/
Source/bin/
Source/**/obj/
Source/**/bin/

# Claude Code session worktrees and their local settings. A session creates its worktree in
# the folder it is working in, and each one is a full copy of the repository it came out of.
# Never shared, and never published.
.claude/

# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# Game-generated texture caches and local render scratch.
*.dds
Art/.render/

# System
Thumbs.db
desktop.ini
.DS_Store
