<Project>

  <PropertyGroup>
    <!--
      Build intermediates are sent outside the mod folder. RimWorld's Workshop uploader sends the
      whole folder (SteamUGC.SetItemContent on its root, with no exclusion possible): leaving obj/
      inside it means publishing the publicised reference Assembly-CSharp.dll, and so redistributing
      the game's own code. This has to stay in a Directory.Build.props: NuGet restore reads the
      property before the csproj is evaluated.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\build\obj\PerfectlyGenericItemPatched\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\build\bin\PerfectlyGenericItemPatched\</BaseOutputPath>
  </PropertyGroup>

</Project>
